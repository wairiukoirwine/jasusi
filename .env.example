# Copy to .env and fill in. Never commit .env.
APP_ENV=development

# Storage. Defaults run with no services: SQLite file + in-memory cache.
# With `docker compose up -d`, switch to the two lines below.
DATABASE_URL=sqlite:///./jasusi.db
REDIS_URL=
# DATABASE_URL=postgresql+psycopg://jasusi:jasusi@localhost:5432/jasusi
# REDIS_URL=redis://localhost:6379/0
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Threat intelligence (optional; a provider is skipped when its key is empty)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHTANK_APP_KEY=
WHOIS_ENABLED=false

# Trained models (gitignored). Missing files -> rule-based fallback detectors.
TEXT_MODEL_PATH=ml/models/text/current.joblib
URL_MODEL_PATH=ml/models/url/current.json

RISK_THRESHOLD_SUSPICIOUS=30
RISK_THRESHOLD_SCAM=70
RATE_LIMIT_PER_MINUTE=30
REQUIRE_API_KEY=false

# Needed to keep donated message text (anonymised + encrypted). Empty = never stored.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FEEDBACK_ENCRYPTION_KEY=
